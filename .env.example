# ============================================================
# AgentService平台 - 环境变量配置模板
# 复制此文件为 .env 并根据实际情况修改
# ============================================================

# ========== 应用配置 ==========
APP_ENV=development
DEBUG=true
LOG_LEVEL=info

# ========== MySQL 数据库 ==========
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=agent_service

# ========== Redis (P2必需: 短期记忆缓存) ==========
# 如已有则无需重复，如端口/密码等为空则补齐默认值
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ========== MinIO (P2必需: Skill本地文件存储) ==========
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=agent-skills
MINIO_USE_SSL=false

# ========== Milvus (P2必需: 长期记忆向量化) ==========
MILVUS_HOST=localhost
MILVUS_PORT=19530
MILVUS_COLLECTION=agent_memory_vectors

# ========== RabbitMQ 消息队列 ==========
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest

# ========== 加密密钥 ==========
# 重要: 生产环境请使用强随机密钥 (32字符)
ENCRYPTION_KEY=a-32-char-secret-key-1234567890abcdef

# ========== 前端 ==========
FRONTEND_PORT=8080

# ========== LLM API Keys (根据需要填写) ==========
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
QWEN_API_KEY=
DEEPSEEK_API_KEY=
